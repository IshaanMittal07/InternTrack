# Copy to .env.local and fill in. Never commit .env.local.
# Values below are placeholders. For local development, `npx supabase status`
# prints the real local values.

# --- Public (safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# --- Server-only (never prefix with NEXT_PUBLIC_) ---
# IANA time zone used for "today", deadlines and follow-ups. Defaults to UTC.
APP_TIMEZONE=America/Toronto

# --- Optional: Outlook / Microsoft 365 email sync (see DEPLOYMENT.md) ---
# Server-only. Leave unset to turn Outlook sync off; Gmail sync needs none of these.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EMAIL_ENCRYPTION_KEY=

# --- Local development and tests ONLY. Never set these in Vercel. ---
# The app never reads these; only the test suites do.
SUPABASE_SERVICE_ROLE_KEY=your-LOCAL-service-role-or-secret-key
MAILPIT_URL=http://127.0.0.1:54324
